# ---------------------------------------------------------------- 构建产物
# 含 CMakeCache 里的绝对路径，换机即失效；体积以十 MB 计
build/
cmake-build-*/

# ---------------------------------------------------- 虚拟环境与解释器缓存
.venv*/
__pycache__/
*.pyc

# ------------------------------------------------ 测量素材（体积大，可重建）
# 7.0 GB 测试用 ISO。进库会让仓库永久膨胀，且二进制无法被 git 压缩
m0-baseline/downloads/
# aria2c.exe / 7z.msi / aria2.zip 等第三方二进制
m0-baseline/vendor/
# 单个 50 MB 的 aria2 调试日志
m0-baseline/out/aria2.log
# 探针下载的种子 payload，合计 2.2 GB
engine-probe/probe-*/

# ---------------------------------------------------------------- 临时产物
docs-motion/.shots/
docs-motion/.edge*/
docs-motion/.chrome*/
# natdiag 根目录下的调试残留；golden/ 子目录的基线不受影响
natdiag/*.log
# 工具链自检产物
engine-probe/toolchain_check/*.exe

# --------------------------------------------------------- 前端（desktop）
# package-lock.json 必须进库：AC-01 要求「从锁文件复现安装」，
# 排除它就等于让 npm ci 无从谈起
desktop/node_modules/
desktop/dist/
desktop/dist-perf/
desktop/.vite/
desktop/*.log

# ------------------------------------------------- Tauri 壳（desktop/src-tauri）
# target 含上百 MB 编译产物与绝对路径，换机即失效
desktop/src-tauri/target/
# gen/ 是 tauri-build 生成的 schema，每次构建自动重建
desktop/src-tauri/gen/

# ------------------------------------------------------- 跨机测试包（cross）
# RUN.md 与 collect-env.ps1 是手写的，入库；
# perf.html 是构建产物（与 desktop/dist 里那份字节一致），入库会让每次构建都产生 diff。
# out/ 是采集结果，只属于采它的那台机器。
crossmachine/perf.html
crossmachine/MANIFEST.json
crossmachine/out/
# 压缩包与 .sha256 都是产物，同样可由上面两条命令重建
crossmachine/dist/

# ------------------------------------------------------ 本地留底（不进库）
# 无 SSL 版 libtorrent 构建产物备份，重编覆盖前的唯一退路
artifacts/

# ------------------------------------------------- 真机执行包（handoff）
# 手写件（README.md / preflight.ps1）入库；
# dist/ 是把安装包、帧率包、运行库复制到一起的产物（3.3 MB），可由
# `python toolchain/pack_handoff.py` 重建；out/ 是脚本在本机跑出来的报告。
handoff/dist/
handoff/out/

# ------------------------------------------------- 内部工作文档（不上公共仓库）
# 进度账本、人工验收清单、内部复盘笔记——只属于本机协作，含过程细节与未填待办
PROGRESS.md
overview.md
handoff/CHECKLIST.md
# 本工作区 AI 协作规则（含内部教训，不对公众）
AGENTS.md

# 提交信息草稿（临时）
.workbuddy/msg-*.txt
# 工作区内部记忆（含私有路径、本机 IP，绝不上公共仓库）
.workbuddy/memory/
*.obj
